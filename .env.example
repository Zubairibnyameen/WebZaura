# Browser-safe: Supabase project URL used by the browser client.
VITE_SUPABASE_URL=
# Browser-safe: Supabase anon/publishable key used by the browser client.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Supabase project URL used for SSR and auth middleware.
SUPABASE_URL=
# Server-only: Supabase anon/publishable key used for SSR and auth middleware.
SUPABASE_PUBLISHABLE_KEY=
# Server-only: Supabase service role key; bypasses RLS, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: initial admin password used by the team bootstrap function.
ADMIN_BOOTSTRAP_PASSWORD=
# Server-only: public site URL used for canonical and metadata links.
SITE_URL=
# Server-only: current cron request secret.
CRON_SECRET=
# Server-only: previous cron request secret, used during secret rotation.
CRON_SECRET_PREVIOUS=
# Server-only: database URL used by Drizzle migration tooling.
SUPABASE_DB_URL=
